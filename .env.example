# Utpost – miljövariabler (M6). Kopiera till .env lokalt om du vill avvika från standardvärdena;
# .env är gitignorerad. I molnet sätts allt detta i plattformen (infra/azure/staging.yaml),
# hemligheterna som secrets – aldrig i en fil som committas.

# API
DATABASE_URL=postgres://utpost:utpost@localhost:5433/utpost        # compose: @postgres:5432 · Azure: @localhost:5432 (sidecar)
MONGO_URL=mongodb://utpost:utpost@localhost:27017/utpost?authSource=admin
JWT_SECRET=                                                        # HEMLIGHET, krävs (API:et startar inte utan). Generera: openssl rand -hex 32 – ett eget värde per miljö, aldrig i en fil som committas. M8: token gäller 1 h, HS256
PORT=4000
SEED_ON_START=0                                                    # 1 i staging: tom databas vid start → seed + migrate:logs

# Bildfunktionen (M7) – functions/, lokalt med func start (npm run dev:functions)
IMAGE_FUNCTION_URL=http://localhost:7071/api/process-image         # compose: http://host.docker.internal:7071/… · Azure: https://<function-app>.azurewebsites.net/api/process-image
IMAGE_FUNCTION_KEY=                                                # HEMLIGHET i Azure (funktionsnyckeln, secret image-function-key). Tom lokalt – func start kräver ingen nyckel

# CMS (M9) – redaktionens innehåll bor i Contentful (api/src/cms/contentful.js). Utan space och delivery-nyckel
# är CMS:et avstängt: appen kör, utan notiser. Space-id:t är ingen hemlighet, nycklarna är det.
CONTENTFUL_SPACE_ID=                                               # Settings > General settings > Space ID
CONTENTFUL_DELIVERY_TOKEN=                                         # HEMLIGHET. Settings > API keys > Content Delivery API – access token. Läser bara det som är publicerat
CONTENTFUL_PREVIEW_TOKEN=                                          # HEMLIGHET. Samma API key > Content Preview API – access token. Läser även utkast – bara för redaktionens förhandsgranskning
CONTENTFUL_MANAGEMENT_TOKEN=                                       # HEMLIGHET, din personliga (Settings > CMA tokens). Bara för npm run cms:setup – appen använder den aldrig, och den ska inte till molnet
CMS_WEBHOOK_SECRET=                                                # HEMLIGHET. Det Contentful skickar i headern X-Utpost-Webhook-Secret när något publiceras. Generera: openssl rand -hex 24. Tom = webhooken är stängd
CMS_CACHE_SECONDS=60                                               # hur länge publicerade notiser svaras ur minnet innan Contentful tillfrågas igen

# Klienten (nginx i client-imagen)
API_UPSTREAM=api:4000                                              # vart /api och /graphql skickas. Azure: localhost:4000
